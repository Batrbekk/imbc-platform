{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# 25 MB files plus multipart overhead, matching the existing nginx ingress.
	request_body {
		max_size 30MB
	}

	@api path /api /api/*
	handle @api {
		# Signed logout notifications arrive directly from the identity service internally.
		# Keep this inside the API handle: top-level handle runs before respond.
		@backchannel path_regexp (?i)^/api/auth/backchannel-logout/?$
		respond @backchannel 404
		reverse_proxy api:3001 {
			transport http {
				response_header_timeout 120s
			}
		}
	}

	@keycloak path /kc /kc/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	# Preserve /dev-mail/ because Mailpit serves this prefix via MP_WEBROOT.
	# Mailpit enforces its own MP_UI_AUTH inherited from compose.yaml.
	@devMail path /dev-mail /dev-mail/*
	handle @devMail {
		reverse_proxy mailpit:8025
	}

	handle {
		reverse_proxy web:3000
	}
}
