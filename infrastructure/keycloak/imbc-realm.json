          "temporary": false
        }
      ]
    },
    {
      "username": "operator@operator.local",
      "email": "operator@operator.local",
      "firstName": "Специалист",
      "lastName": "Оператора",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "locale": [
          "ru"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_USER_PASSWORD}",
