# ─── IMBC Platform: переменные dev-стенда ───────────────────────────────────
# cp .env.example .env  и замените все значения change-me (make secrets сгенерирует случайные).

# Публичный адрес, по которому браузер открывает стенд (nginx). Без завершающего «/».
# Для `pnpm dev` на хосте: http://localhost:3000
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Cookies. Для HTTPS-стенда: COOKIE_SECURE=true и имена с префиксом __Host- (архитектура §9).
COOKIE_SECURE=false
SESSION_COOKIE_NAME=imbc-session
DEVICE_COOKIE_NAME=imbc-device
SESSION_SECRET=change-me-at-least-32-characters-long-secret

# PostgreSQL 18: владелец схемы (миграции) и роль приложения (без UPDATE/DELETE на audit_entries).
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# S3 (RustFS)
S3_ACCESS_KEY=imbc-dev
S3_SECRET_KEY=change-me-s3-secret

# Keycloak
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
OIDC_CLIENT_SECRET=change-me-bff-client-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-api-secret
# HTTPS для входа: external — обязателен для всех, кроме локальных адресов; none — dev-стенд по http на публичном IP
KEYCLOAK_SSL_REQUIRED=external
# Пароль демо-пользователей realm (не короче 12 символов — политика AUTH-02)
KEYCLOAK_DEV_USER_PASSWORD=Imbc-dev-2026!

# ─── Почта ──────────────────────────────────────────────────────────────────
# По умолчанию всё (коды входа, установка пароля, уведомления) уходит в Mailpit: http://<host>:8025
# Реальная доставка: укажите релей IMBC для платформы (SMTP_URL) и для Keycloak (KEYCLOAK_SMTP_*).
#   SMTP_URL=smtps://user:password@smtp.imbc.kz:465   или  smtp://user:password@smtp.imbc.kz:587 (STARTTLS)
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=IMBC Platform <no-reply@imbc.local>
IMBC_MAILBOX=platform@imbc.local
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@imbc.local
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=false
MAILPIT_UI_PORT=8025
MAILPIT_UI_AUTH=
RUSTFS_CONSOLE_PORT=9001

# Демо-данные (6 учётных записей, 8 вымышленных компаний). На стейдже — false.
SEED_DEMO=true
LOG_LEVEL=info
IMAGE_TAG=dev
NODE_VERSION=26
