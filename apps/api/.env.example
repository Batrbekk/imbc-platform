# Для `pnpm dev` на хосте при поднятой инфраструктуре (`make infra`). Значения — как в корневом .env.
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://imbc_app:change-me-app@localhost:5432/imbc
VALKEY_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=imbc-dev
S3_SECRET_KEY=change-me-s3-secret
OIDC_ISSUER=http://localhost:3000/kc/realms/imbc
OIDC_INTERNAL_URL=http://localhost:8180
OIDC_CLIENT_SECRET=change-me-bff-client-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-api-secret
SESSION_SECRET=change-me-at-least-32-characters-long-secret
SESSION_COOKIE_NAME=imbc-session
DEVICE_COOKIE_NAME=imbc-device
COOKIE_SECURE=false
SMTP_URL=smtp://localhost:1025
CLAMAV_HOST=localhost
