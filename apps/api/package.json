{
  "name": "@imbc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "dev:worker": "PROCESS_ROLE=worker nest start --watch --entryFile worker",
    "start:worker": "node dist/worker.js",
    "db:seed": "node dist/database/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@imbc/contracts": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.4.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "drizzle",
    "reference-data"
  ]
}
